{
  "name": "capybara-simulated-vendor",
  "private": true,
  "description": "Build-time bundling for vendored JS deps and the bridge. The gem ships the pre-built bundles (`vendor/js/vendor.bundle.js`, `lib/capybara/simulated/js/bridge.bundle.js`); npm is needed only when updating them.",
  "scripts": {
    "build:vendor": "esbuild vendor/src/vendor.entry.js --bundle --format=iife --keep-names --minify --global-name=__csimVendor --alias:tr46=./vendor/src/tr46-ascii.js --alias:@exodus/bytes/whatwg.js=./vendor/src/exodus-bytes-utf8.js --alias:@exodus/bytes/encoding.js=./vendor/src/exodus-bytes-utf8.js --outfile=vendor/js/vendor.bundle.js",
    "build:bridge": "esbuild lib/capybara/simulated/js/src/bridge.entry.js --bundle --format=iife --keep-names --define:__CSIM_VERIFY_STYLE_CACHE__=false --outfile=lib/capybara/simulated/js/bridge.bundle.js",
    "build": "pnpm run build:vendor && pnpm run build:bridge",
    "gen:css-property-data": "node script/gen_css_property_data.js",
    "gen:idl": "node script/gen_idl_surface.mjs",
    "vendor:wpt": "node script/vendor_wpt.mjs"
  },
  "dependencies": {
    "css-select": "^7.0.0",
    "css-tree": "^3.2.1",
    "css-what": "^8.0.0",
    "culori": "^4.0.2",
    "parse5": "^8.0.0",
    "urlpattern-polyfill": "^10.1.0",
    "web-streams-polyfill": "^4.3.0",
    "whatwg-mimetype": "^5.0.0",
    "xpathway": "^1.0.4"
  },
  "devDependencies": {
    "@webref/idl": "^3.79.0",
    "esbuild": "^0.28.1",
    "url-polyfill": "^1.1.14",
    "whatwg-url": "^16.0.1"
  }
}
